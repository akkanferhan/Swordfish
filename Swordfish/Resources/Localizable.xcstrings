    "Swordfish": {
      "shouldTranslate": false
    },
    "Swordfish needs your password once to control lid-closed sleep without further prompts.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Swordfish, kapak kapalıyken uykuyu bir daha sormadan yönetebilmek için parolanıza bir kez ihtiyaç duyuyor."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Swordfish necesita tu contraseña una vez para controlar el reposo con la tapa cerrada sin más solicitudes."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Swordfish a besoin de votre mot de passe une seule fois pour contrôler la veille capot fermé sans autres demandes."
          }
        },
        "sr": {
          "stringUnit": {
            "state": "translated",
            "value": "Swordfish-у је једном потребна ваша лозинка да би управљао спавањем при затвореном поклопцу без даљих упита."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Swordfish は、ふたを閉じたときのスリープを以後の確認なしに制御するため、一度だけパスワードを必要とします。"
          }
        },
        "sr-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Swordfish-u je jednom potrebna vaša lozinka da bi upravljao spavanjem pri zatvorenom poklopcu bez daljih upita."
          }
        }
      }
    },
    "Swordfish needs your password once to enable network throttling without further prompts.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Swordfish, ağ kısıtlamayı bir daha sormadan etkinleştirebilmek için parolanıza bir kez ihtiyaç duyuyor."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Swordfish necesita tu contraseña una vez para activar la limitación de red sin más solicitudes."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Swordfish a besoin de votre mot de passe une seule fois pour activer la limitation réseau sans autres demandes."
          }
        },
        "sr": {
          "stringUnit": {
            "state": "translated",
            "value": "Swordfish-у је једном потребна ваша лозинка да би омогућио ограничавање мреже без даљих упита."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Swordfish は、ネットワークスロットリングを以後の確認なしに有効化するため、一度だけパスワードを必要とします。"
          }
        },
        "sr-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Swordfish-u je jednom potrebna vaša lozinka da bi omogućio ograničavanje mreže bez daljih upita."
          }
        }
      }
    },
    "Swordfish needs your password to point xcode-select at Xcode.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "xcode-select'i Xcode'a yönlendirmek için Swordfish parolanıza ihtiyaç duyuyor."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Swordfish necesita tu contraseña para apuntar xcode-select a Xcode."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Swordfish a besoin de votre mot de passe pour pointer xcode-select vers Xcode."
          }
        },
        "sr": {
          "stringUnit": {
            "state": "translated",
            "value": "Swordfish-у је потребна ваша лозинка да усмери xcode-select на Xcode."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "xcode-select を Xcode に向けるには Swordfish にパスワードが必要です。"
          }
        },
        "sr-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Swordfish-u je potrebna vaša lozinka da usmeri xcode-select na Xcode."
          }
        }
      }
    },
    "Swordfish needs your password to remove the lid-closed anti-sleep helper.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kapak kapalı uyku engelleme yardımcısını kaldırmak için Swordfish parolanıza ihtiyaç duyuyor."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Swordfish necesita tu contraseña para eliminar el ayudante que evita el reposo con la tapa cerrada."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Swordfish a besoin de votre mot de passe pour supprimer l'assistant anti-veille capot fermé."
          }
        },
        "sr": {
          "stringUnit": {
            "state": "translated",
            "value": "Swordfish-у је потребна ваша лозинка да уклони помоћника против спавања при затвореном поклопцу."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "クラムシェルモードのスリープ防止ヘルパーを削除するには Swordfish にパスワードが必要です。"
          }
        },
        "sr-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Swordfish-u je potrebna vaša lozinka da ukloni pomoćnika protiv spavanja pri zatvorenom poklopcu."
          }
        }
      }
    },
    "Swordfish needs your password to remove the network throttling helper.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ağ kısıtlama yardımcısını kaldırmak için Swordfish parolanıza ihtiyaç duyuyor."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
