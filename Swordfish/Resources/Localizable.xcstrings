    "This microphone doesn't allow muting from other apps" : {

    },
    "Throttle the Mac's network (Wi-Fi / Ethernet) so iOS Simulators and apps see slower connections. Uses the same dummynet engine as Apple's Network Link Conditioner." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Limita la red del Mac (Wi-Fi / Ethernet) para que los Simuladores de iOS y las apps vean conexiones más lentas. Usa el mismo motor dummynet que el Network Link Conditioner de Apple."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Limite le réseau du Mac (Wi-Fi / Ethernet) pour que les simulateurs iOS et les apps voient des connexions plus lentes. Utilise le même moteur dummynet que le Network Link Conditioner d'Apple."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mac のネットワーク（Wi-Fi / Ethernet）を制限し、iOS シミュレータやアプリに低速な接続を見せます。Apple の Network Link Conditioner と同じ dummynet エンジンを使用します。"
          }
        },
        "sr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ограничите мрежу Mac-а (Wi-Fi / Ethernet) тако да iOS симулатори и апликације виде спорије везе. Користи исти dummynet механизам као Apple-ов Network Link Conditioner."
          }
        },
        "sr-Latn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ograničite mrežu Mac-a (Wi-Fi / Ethernet) tako da iOS simulatori i aplikacije vide sporije veze. Koristi isti dummynet mehanizam kao Apple-ov Network Link Conditioner."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mac'in ağını (Wi-Fi / Ethernet) kısıtlayarak iOS Simülatörlerinin ve uygulamaların daha yavaş bağlantı görmesini sağlar. Apple'ın Network Link Conditioner'ı ile aynı dummynet motorunu kullanır."
          }
        }
      }
    },
    "Throttle Wi-Fi / Ethernet so Simulators & apps see slower networks" : {
      "localizations" : {
