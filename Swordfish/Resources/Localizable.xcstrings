      }
    },
    "One-time admin prompt. Swordfish writes a sudoers entry so future toggles don't ask for your password.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bir kerelik yönetici onayı. Swordfish bir sudoers kaydı yazar; sonraki açma/kapamalarda parola sorulmaz."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Solicitud de administrador única. Swordfish escribe una entrada en sudoers para que los próximos cambios no pidan tu contraseña."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Demande admin unique. Swordfish écrit une entrée sudoers pour que les prochains basculements ne demandent plus votre mot de passe."
          }
        },
        "sr": {
          "stringUnit": {
            "state": "translated",
            "value": "Једнократни администраторски упит. Swordfish уписује sudoers ставку како будућа укључивања не би тражила вашу лозинку."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "管理者認証は一度だけです。Swordfish が sudoers エントリを書き込むため、以降の切り替えではパスワードを求められません。"
          }
        },
        "sr-Latn": {
          "stringUnit": {
            "state": "translated",
            "value": "Jednokratni administratorski upit. Swordfish upisuje sudoers stavku kako buduća uključivanja ne bi tražila vašu lozinku."
          }
        }
      }
    },
