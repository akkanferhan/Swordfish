          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Swordfish a besoin de votre mot de passe pour supprimer l'assistant de limitation réseau."
          }
        },
        "sr": {
          "stringUnit": {
            "state": "translated",
            "value": "Swordfish-у је потребна ваша лозинка да уклони помоћника за ограничавање мреже."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ネットワークスロットリングヘルパーを削除するには Swordfish にパスワードが必要です。"
          }
        },
        "sr-Latn": {
          "stringUnit": {
